# Copy to .env.local for local development. On Netlify, set these in Site configuration > Environment variables.
# Never commit real values.

# Required on Netlify for enquiries to reach you. Server-side only, never prefix with NEXT_PUBLIC_.
# Any endpoint that accepts a JSON POST works (Zapier, Make, Slack incoming webhook, Apps Script, your own).
# Without it the form tells visitors nothing was sent and offers WhatsApp, phone and email.
ENQUIRY_WEBHOOK_URL=

# Optional. Already set to the production domain in netlify.toml. Used for canonical URLs, sitemap, robots and social previews.
NEXT_PUBLIC_SITE_URL=https://ironsirony.hycyon.com
